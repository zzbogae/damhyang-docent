{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mined.week/8",
  "title": "Mine D 주 레코드 v8",
  "type": "object",
  "required": [
    "schema",
    "week",
    "date_start",
    "date_end",
    "candidate",
    "coverage",
    "ind",
    "axes",
    "badges",
    "evidence",
    "grade",
    "grade_history",
    "access",
    "era",
    "mineral",
    "shape",
    "similar",
    "sentence",
    "gyeol",
    "return_week",
    "hold_until"
  ],
  "properties": {
    "schema": {
      "const": "mined.week/8"
    },
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$"
    },
    "date_start": {
      "type": "string",
      "format": "date"
    },
    "date_end": {
      "type": "string",
      "format": "date"
    },
    "candidate": {
      "type": "boolean"
    },
    "coverage": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "health",
          "memo",
          "photo",
          "yt",
          "cal",
          "kakao",
          "sns",
          "ai",
          "quiet",
          "screen",
          "git"
        ]
      },
      "additionalProperties": {
        "enum": [
          "observed",
          "structural_missing",
          "partial"
        ]
      }
    },
    "ind": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "v",
          "pr",
          "n_base",
          "rank_low",
          "rank_high",
          "why"
        ],
        "properties": {
          "v": {
            "type": [
              "number",
              "null"
            ]
          },
          "pr": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "n_base": {
            "type": "integer",
            "minimum": 0
          },
          "rank_low": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "rank_high": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "why": {
            "enum": [
              null,
              "missing",
              "baseline_short",
              "no_denominator"
            ]
          }
        }
      }
    },
    "axes": {
      "type": "object",
      "required": [
        "move",
        "rest",
        "watch",
        "leave"
      ],
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "pr",
              "n_base",
              "z"
            ],
            "properties": {
              "pr": {
                "type": "number"
              },
              "n_base": {
                "type": "integer"
              },
              "z": {
                "type": "number"
              }
            }
          }
        ]
      }
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "indicator",
          "label",
          "family",
          "axis",
          "direction",
          "pr",
          "rank",
          "n_base",
          "extreme"
        ],
        "properties": {
          "direction": {
            "enum": [
              "up",
              "down"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "extreme": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "axis": {
            "enum": [
              "move",
              "rest",
              "watch",
              "leave"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "families",
        "independent",
        "cross_validated"
      ],
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "independent": {
          "type": "integer",
          "minimum": 0
        },
        "cross_validated": {
          "type": "boolean"
        },
        "linked": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "a",
              "b",
              "rho"
            ]
          }
        }
      }
    },
    "grade": {
      "enum": [
        null,
        "held",
        "returned",
        "open",
        "insufficient",
        "broken",
        "not_returned"
      ]
    },
    "grade_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "as_of",
          "grade"
        ],
        "properties": {
          "grade": {
            "enum": [
              "held",
              "returned",
              "open",
              "insufficient",
              "broken",
              "not_returned"
            ]
          }
        }
      }
    },
    "return_week": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-W\\d{2}$"
    },
    "hold_until": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-W\\d{2}$"
    },
    "access": {
      "enum": [
        "auto",
        "confirm"
      ]
    },
    "era": {
      "type": [
        "string",
        "null"
      ]
    },
    "episode": {
      "type": [
        "string",
        "null"
      ]
    },
    "mineral": {
      "enum": [
        null,
        "호박",
        "황철석",
        "청금석",
        "월장석",
        "자수정",
        "홍옥",
        "흑요석",
        "석류석",
        "형석"
      ]
    },
    "gyeol": {
      "enum": [
        null,
        "mixed",
        "coarse",
        "regular"
      ]
    },
    "shape": {
      "enum": [
        null,
        "angular",
        "round",
        "diamond"
      ]
    },
    "similar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "week",
          "distance",
          "shared_families",
          "same_direction"
        ],
        "properties": {
          "same_direction": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_]+:(up|down)$"
            }
          }
        }
      }
    },
    "sentence": {
      "type": [
        "string",
        "null"
      ]
    },
    "sentence_plain": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
